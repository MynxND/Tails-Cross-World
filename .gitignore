# Security boundary: this directory also contains the private legacy build.
# Keep the repository deny-by-default and explicitly allow only clean-room work.
*

!.gitignore
!.gitattributes
!README.md
!pyproject.toml
!docs/
!docs/**
!tools/
!tools/**
!tests/
!tests/**
!src/
!src/**
!scripts/
!scripts/**
!content/
!content/**
!art-source/
!art-source/**
!client/
!client/Assets/
!client/Assets/**
!client/Packages/
!client/Packages/**
!client/ProjectSettings/
!client/ProjectSettings/**
!.github/
!.github/**

# Local reports and caches stay private.
artifacts/
server-data/
*.blend1
tmp/
**/__pycache__/
*.py[cod]
.pytest_cache/
tools/**/bin/
tools/**/obj/
client/Library/
client/Logs/
client/Temp/
client/UserSettings/
client/Builds/
client/*.csproj
client/*.sln
client/Assets/TutorialInfo/
client/Assets/TutorialInfo.meta
client/Assets/Scenes/
client/Assets/Scenes.meta
client/Assets/Readme.asset
client/Assets/Readme.asset.meta
client/Assets/InputSystem_Actions.inputactions
client/Assets/InputSystem_Actions.inputactions.meta

# Locally imported assets from the user's original Twelve Tails installation.
# These are required for visual parity but must never be committed or published.
client/Assets/TwelveTails/LegacyPrivate/
client/Assets/TwelveTails/LegacyPrivate.meta
